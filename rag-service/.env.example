# ==================== EduFarm RAG Service ====================
# Copy this file to .env and adjust values for your machine:
#   cp .env.example .env

# -------------------- Server --------------------
HOST=0.0.0.0
PORT=8000

# -------------------- LLM provider --------------------
# Current implementation supports local generation via Ollama.
LLM_PROVIDER=ollama

# -------------------- Embeddings --------------------
# Local ONNX embedding function used by ChromaDB.
# If you change this value after indexing documents, clear and reload ChromaDB.
EMBEDDING_FUNCTION=onnx_minilm_l6_v2

# -------------------- Ollama local LLM --------------------
# For local non-Docker run on Windows use http://localhost:11434.
# For Docker Compose with Ollama running on host use http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-3b-instruct-q4km
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=700
OLLAMA_TIMEOUT_SECONDS=120

# -------------------- ChromaDB --------------------
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=edufarm_textbooks
# If an old incompatible ChromaDB schema is detected, move it to *_backup_* and recreate DB.
CHROMA_RESET_ON_SCHEMA_ERROR=true

# -------------------- Document processing --------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# -------------------- Query and context limits --------------------
# MAX_CONTEXT_DOCUMENTS is the total number of chunks passed to the LLM context.
# It is not a number of textbooks and not a per-textbook limit.
MAX_CONTEXT_DOCUMENTS=5
MAX_QUERY_LENGTH=500

# -------------------- Retrieval quality --------------------
# 0 disables distance filtering. For cosine distance, lower means closer.
RETRIEVAL_DISTANCE_THRESHOLD=1.2
# Fetch extra candidates before filtering/diversification.
RETRIEVAL_FETCH_MULTIPLIER=3
# Soft limit per textbook. If not enough chunks remain, the service fills from best skipped chunks.
RETRIEVAL_MAX_CHUNKS_PER_TEXTBOOK=2

# -------------------- Observability --------------------
SENTRY_DSN=
ENABLE_METRICS=true
